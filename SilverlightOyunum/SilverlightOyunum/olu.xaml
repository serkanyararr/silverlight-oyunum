<UserControl
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	x:Class="SilverlightOyunum.olu" xmlns:vsm="clr-namespace:System.Windows;assembly=System.Windows" Height="300" Width="400">

	<UserControl.Resources>
		<ControlTemplate x:Key="ButtonControlTemplate1" TargetType="Button">
			<Grid>
				<vsm:VisualStateManager.VisualStateGroups>
					<vsm:VisualStateGroup x:Name="FocusStates">
						<vsm:VisualState x:Name="Unfocused"/>
						<vsm:VisualState x:Name="Focused"/>
					</vsm:VisualStateGroup>
					<vsm:VisualStateGroup x:Name="CommonStates">
						<vsm:VisualStateGroup.Transitions>
							<vsm:VisualTransition From="MouseOver" GeneratedDuration="00:00:01" To="Normal"/>
							<vsm:VisualTransition From="Normal" GeneratedDuration="00:00:01" To="MouseOver"/>
						</vsm:VisualStateGroup.Transitions>
						<vsm:VisualState x:Name="MouseOver">
							<Storyboard>
								<DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="rectangle" Storyboard.TargetProperty="(Shape.Fill).(GradientBrush.GradientStops)[0].(GradientStop.Offset)">
									<SplineDoubleKeyFrame KeyTime="00:00:00" Value="0.781"/>
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
						</vsm:VisualState>
						<vsm:VisualState x:Name="Normal"/>
						<vsm:VisualState x:Name="Pressed"/>
						<vsm:VisualState x:Name="Disabled"/>
					</vsm:VisualStateGroup>
				</vsm:VisualStateManager.VisualStateGroups>
				<Rectangle x:Name="rectangle" Stroke="#FF000000" RadiusX="20" RadiusY="20">
					<Rectangle.Fill>
						<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
							<GradientStop Color="#FFB2CFFF" Offset="0.217"/>
							<GradientStop Color="#FF032337" Offset="1"/>
							<GradientStop Color="#FF032337" Offset="0"/>
						</LinearGradientBrush>
					</Rectangle.Fill>
				</Rectangle>
				<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Portable User Interface" FontSize="24" FontWeight="Bold" Foreground="#FF000000" Text="BAŞLA" TextWrapping="Wrap"/>
			</Grid>
		</ControlTemplate>
		<ControlTemplate x:Key="ButtonControlTemplate2" TargetType="Button">
			<Grid>
				<vsm:VisualStateManager.VisualStateGroups>
					<vsm:VisualStateGroup x:Name="FocusStates">
						<vsm:VisualState x:Name="Unfocused"/>
						<vsm:VisualState x:Name="Focused"/>
					</vsm:VisualStateGroup>
					<vsm:VisualStateGroup x:Name="CommonStates">
						<vsm:VisualStateGroup.Transitions>
							<vsm:VisualTransition From="MouseOver" GeneratedDuration="00:00:01" To="Normal"/>
							<vsm:VisualTransition From="Normal" GeneratedDuration="00:00:01" To="MouseOver"/>
						</vsm:VisualStateGroup.Transitions>
						<vsm:VisualState x:Name="MouseOver">
							<Storyboard>
								<DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Duration="00:00:00.0010000" Storyboard.TargetName="rectangle" Storyboard.TargetProperty="(Shape.Fill).(GradientBrush.GradientStops)[0].(GradientStop.Offset)">
									<SplineDoubleKeyFrame KeyTime="00:00:00" Value="0.781"/>
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
						</vsm:VisualState>
						<vsm:VisualState x:Name="Normal"/>
						<vsm:VisualState x:Name="Pressed"/>
						<vsm:VisualState x:Name="Disabled"/>
					</vsm:VisualStateGroup>
				</vsm:VisualStateManager.VisualStateGroups>
				<Rectangle x:Name="rectangle" Stroke="#FF000000" RadiusX="20" RadiusY="20">
					<Rectangle.Fill>
						<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
							<GradientStop Color="#FFB2CFFF" Offset="0.217"/>
							<GradientStop Color="#FF032337" Offset="1"/>
							<GradientStop Color="#FF032337" Offset="0"/>
						</LinearGradientBrush>
					</Rectangle.Fill>
				</Rectangle>
				<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Portable User Interface" FontSize="16" FontWeight="Bold" Foreground="#FF000000" Text="İntikamını AL" TextWrapping="Wrap"/>
			</Grid>
		</ControlTemplate>
	</UserControl.Resources>

	<Grid x:Name="LayoutRoot" Height="300" Width="400" Background="#FF000000" d:IsLocked="True">
		<Rectangle HorizontalAlignment="Left" Margin="177,67,0,21" Stroke="Black" Width="212" d:IsLocked="True">
			<Rectangle.Fill>
				<ImageBrush Stretch="Fill" ImageSource="darth-vader.png"/>
			</Rectangle.Fill>
		</Rectangle>
		<TextBlock Margin="25,22,24,0" VerticalAlignment="Top" FontSize="20" Foreground="#FFFFFFFF" Text="Vuruldun ve acılar içinde öldün!" TextWrapping="Wrap" d:IsLocked="True"/>
		<TextBlock Margin="25,67,168,0" VerticalAlignment="Top" FontSize="14" Foreground="#FFFFFFFF" Text="Vurulan Gemi:" TextWrapping="Wrap" x:Name="Skor" d:IsLocked="True"/>
		<Button Margin="25,0,0,22" Template="{StaticResource ButtonControlTemplate2}" Content="Button" x:Name="Basla" Cursor="Hand" Height="47" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="152" d:IsLocked="True">
			<Button.Background>
				<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
					<GradientStop Color="#FF032337" Offset="0"/>
					<GradientStop Color="#FFB2CFFF" Offset="1"/>
				</LinearGradientBrush>
			</Button.Background>
		</Button>
	</Grid>
</UserControl>